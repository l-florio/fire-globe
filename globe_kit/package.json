  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "cesium": "1.147.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-static-copy": "4.1.1"
  }
}
